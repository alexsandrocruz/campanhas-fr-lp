# Copie este arquivo para .env.local e preencha os valores.
# O .env.local nunca sobe pro Git — na Vercel, cadastre em Settings > Environment Variables.

# --- Contato -----------------------------------------------------------
# Numero do WhatsApp em formato internacional, so digitos: 55 + DDD + numero
NEXT_PUBLIC_WHATSAPP=5579999999999

# --- Rastreamento ------------------------------------------------------
# Pixel do Meta e tag do Google Ads ficam fixos em app/layout.tsx —
# e uma campanha so, nao vale a pena passar por variavel de ambiente.

# --- Formulário Dominus Leads ------------------------------------------
# Em produção, substitua pela URL pública da API do Dominus.
NEXT_PUBLIC_LEADS_EMBED_API_URL=https://stg-api.dominusapp.com.br
