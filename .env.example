# Copie este arquivo para .env.local e preencha os valores.
# O .env.local nunca sobe pro Git — na Vercel, cadastre em Settings > Environment Variables.

# --- Contato -----------------------------------------------------------
# Numero do WhatsApp em formato internacional, so digitos: 55 + DDD + numero
NEXT_PUBLIC_WHATSAPP=5579999999999

# --- Rastreamento ------------------------------------------------------
# Deixe vazio em desenvolvimento para nao poluir os dados de producao
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# --- Destino dos leads -------------------------------------------------
# Webhook que recebe o formulario (Make, n8n, Zapier, CRM...)
# Sem esta variavel o formulario continua funcionando: o lead vai pro log da Vercel.
LEAD_WEBHOOK_URL=
